+-- El giro del hombro a lo largo del golpe (ver `claves`); de vuelta pasa por el lado, nunca por delante.
+local function postura(lista: { CFrame }, p: number): CFrame
+	if p >= 4 then
+		if p < 4.4 then
+			return lista[5]:Lerp(lista[3], (p - 4) / 0.4)
+		elseif p < 4.75 then
+			return lista[3]:Lerp(lista[2], (p - 4.4) / 0.35)
+		end
+		return lista[2]:Lerp(lista[1], math.min(1, (p - 4.75) / 0.25))
+	end
+	local i = math.floor(p)
+	return lista[i + 1]:Lerp(lista[i + 2], p - i)
+end
