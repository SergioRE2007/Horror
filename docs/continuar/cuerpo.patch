+	if p.quieta then
+		if not medir(p) then
+			p.t, p.lado = 0, 0 -- un avatar raro: se queda como está
+			return
+		end
+		p.quieta = false
+	end
+	local baja = p.baja * p.t
+	p.raiz.motor.C0 = CFrame.new(0, -baja, 0) * p.raiz.original
+	for _, pierna in p.piernas do
